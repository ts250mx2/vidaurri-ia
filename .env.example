# Copia este archivo a .env y llena los valores reales.

# MySQL (bdav)
MYSQL_SERVER_USER=
MYSQL_SERVER_PASSWORD=
MYSQL_SERVER_SERVER=
MYSQL_SERVER_DATABASE=bdav

# MySQL Bodega Usado (sucursal de partes usadas; base remota, solo lectura)
MYSQL_USADAS_SERVER=
MYSQL_USADAS_PORT=3306
MYSQL_USADAS_USER=
MYSQL_USADAS_PASSWORD=
MYSQL_USADAS_DATABASE=wwapvi_bd-usadas

# MySQL de conversaciones del Vendedor IA (bitácora de chats; aquí sí se escribe)
MYSQL_CONV_SERVER=
MYSQL_CONV_USER=
MYSQL_CONV_PASSWORD=
MYSQL_CONV_DATABASE=BDVidaurriConversaciones

# Agentes inteligentes (VIDA y Vendedor IA)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# VIDA: modelo por defecto (el usuario alterna Opus 5 / GPT-5.6 Sol en la UI)
AGENTES_MODELO=claude-opus-5
# Vendedor IA: modelo fijo (web y WhatsApp)
VENDEDOR_MODELO=claude-sonnet-5

# Firma de la cookie de sesión (mismo valor en dev y producción)
JWT_SECRET=

# API key del webservice del Vendedor IA para WhatsApp (/api/whatsapp/vendedor)
WHATSAPP_API_KEY=

# URL pública HTTPS del sistema (para las fotos que se envían por WhatsApp).
# Si se deja vacía, se deduce del encabezado Host de cada petición.
PUBLIC_BASE_URL=
