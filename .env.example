# Copia este archivo a .env y llena los valores reales.

# MySQL (bdav)
MYSQL_SERVER_USER=
MYSQL_SERVER_PASSWORD=
MYSQL_SERVER_SERVER=
MYSQL_SERVER_DATABASE=bdav

# MySQL Bodega Usado (sucursal de partes usadas; base remota, solo lectura)
MYSQL_USADAS_SERVER=
MYSQL_USADAS_PORT=3306
MYSQL_USADAS_USER=
MYSQL_USADAS_PASSWORD=
MYSQL_USADAS_DATABASE=wwapvi_bd-usadas

# MySQL de conversaciones del Vendedor IA (bitácora de chats; aquí sí se escribe)
MYSQL_CONV_SERVER=
MYSQL_CONV_USER=
MYSQL_CONV_PASSWORD=
MYSQL_CONV_DATABASE=BDVidaurriConversaciones

# Agentes inteligentes (VIDA y Vendedor IA)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# VIDA: modelo por defecto (el usuario alterna Opus 5 / GPT-5.6 Sol en la UI)
AGENTES_MODELO=claude-opus-5
# Vendedor IA: modelo fijo (web y WhatsApp)
VENDEDOR_MODELO=claude-sonnet-5
# Vendedor IA > Clientes con descuento: % que se propone al dar de alta un
# teléfono que NO está en el catálogo de clientes de bdav. Si falta, 33.
DESCUENTO_DEFAULT=38

# Firma de la cookie de sesión (mismo valor en dev y producción)
JWT_SECRET=

# API key del webservice del Vendedor IA para WhatsApp (/api/whatsapp/vendedor)
WHATSAPP_API_KEY=

# Mostrador (vidaurri-page): key servidor->servidor para /api/mostrador/* (distinta
# de WHATSAPP_API_KEY para poder rotarlas por separado) y secreto HS256 del JWT
# del vendedor. Ambos valores deben ser IDENTICOS en el .env de vidaurri-page.
MOSTRADOR_API_KEY=
MOSTRADOR_JWT_SECRET=

# API key de Axon Logic (la que empieza con "axk_"): bienvenida por WhatsApp al
# dar de alta un cliente y módulo de créditos (saldo de tokens y compra de
# packs vía Stripe). Vacía = ambas cosas apagadas, el resto del sistema sigue.
AXON_API_KEY=
# Base de la API de Axon Logic; solo cambiarla para pruebas.
# AXON_API_URL=https://api.axonlogic.com.mx

# URL pública HTTPS del sistema (para las fotos que se envían por WhatsApp y la
# dirección a la que Stripe regresa tras comprar tokens de Axon). Para las fotos,
# si se deja vacía se deduce del encabezado Host; para comprar tokens es obligatoria.
PUBLIC_BASE_URL=

# Cotización en el POS (bdav) al marcar un pedido de mostrador como listo.
# real = inserta en cotiza/detalle_cotiza · simulacion = solo arma y loguea el
# SQL (default si falta) · apagado = no hace nada.
POS_COTIZA_MODO=simulacion
# Back order a Aldo Autopartes en el POS (bdav) al confirmar un pedido de
# mostrador con partidas sobre pedido. real = inserta en back_order/detalle_bko
# y SUBE folios_ventas.folio_bko (el POS toma de ahí el siguiente número; si no
# se subiera, la siguiente back order del POS repetiría el número) ·
# simulacion = solo arma y loguea el SQL (default si falta) · apagado = no hace nada.
POS_BKO_MODO=simulacion
# vendedores.id de bdav con el que se firma la back order cuando el usuario del
# POS que confirmó no está en la tabla vendedores_pos (1 POLENDO, 2 ECHAVARRI, 3 JR).
POS_BKO_VENDEDOR_DEFAULT=3
# Usuario de MySQL para ESAS escrituras (solo INSERT en cotiza/detalle_cotiza y
# back_order/detalle_bko, UPDATE de estatus en cotiza y back_order, y UPDATE de
# folio_bko en folios_ventas). Si faltan se usan MYSQL_SERVER_USER/PASSWORD.
MYSQL_POS_ESCRITURA_USER=
MYSQL_POS_ESCRITURA_PASSWORD=
